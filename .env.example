MILK_MAX_PRICE=
# Umbral exclusivo: solo se alertan ofertas de leche por debajo de este valor (€/L).
MILK_MAX_PRICE_PER_LITER=0.80
MILK_MIN_TEMPERATURE=
MILK_INCLUDE_KEYWORDS=
MILK_EXCLUDE_KEYWORDS=
# Tiendas de las reglas heredadas (check/baseline/run-rules --dry-run). Las
# alertas creadas desde Telegram llevan sus propias tiendas permitidas y
# excluidas dentro de la regla («de Amazon o PcComponentes pero no AliExpress»).
MILK_INCLUDE_MERCHANTS=
MILK_EXCLUDE_MERCHANTS=
BEER_MAX_PRICE=
BEER_MIN_TEMPERATURE=
BEER_INCLUDE_KEYWORDS=
BEER_EXCLUDE_KEYWORDS=
BEER_INCLUDE_MERCHANTS=
BEER_EXCLUDE_MERCHANTS=
# Minutos entre dos avisos operativos del mismo tipo (errores de Chollometro,
# fallos de Telegram...). Un valor menor a 1 se rechaza: el cooldown existe
# justo para que un 503 no se convierta en spam de alertas.
ERROR_ALERT_COOLDOWN_MINUTES=60
# Cadencia del daemon (`chollometro-alerts run`). `--interval-minutes` la
# sobreescribe. El primer ciclo inicializa el feed, y los deals publicados
# después de crear una alerta siguen siendo elegibles para esa alerta.
SCAN_INTERVAL_MINUTES=10
# Health is stale after max(SCAN_INTERVAL_MINUTES * 3, 15 minutes).
# Override only when the scan cadence or expected latency requires it.
HEALTH_STALE_AFTER_MINUTES=30
HEALTH_STARTUP_GRACE_MINUTES=20
# Política HTTP de Chollometro: un timeout explícito y retries acotados con
# backoff exponencial (los 4xx y los fallos de parsing no se reintentan).
CHOLLOMETRO_TIMEOUT_SECONDS=20
CHOLLOMETRO_MAX_RETRIES=2
CHOLLOMETRO_RETRY_BACKOFF_SECONDS=0.5
CHOLLOMETRO_MAX_RETRY_BACKOFF_SECONDS=30
# Descubrimiento por la API GraphQL interna (feed de los últimos threads).
# true: el ciclo pide los últimos chollos una sola vez y evalúa solo los nuevos.
# false: se mantiene el escaneo HTML por consulta, sin tocar el endpoint GraphQL.
CHOLLOMETRO_GRAPHQL_DISCOVERY=true
# Ventana de visibilidad del feed. Sin definir (recomendado) la petición NO
# envía `limit` y el endpoint devuelve su ventana por defecto: 30 threads.
# Un valor entre 1 y 20 pide esa ventana explícita. Un valor >= 21 se rechaza:
# el endpoint lo recorta a 20 sin avisar.
# CHOLLOMETRO_GRAPHQL_WINDOW_LIMIT=20
CHOLLOMETRO_GRAPHQL_PATH=/graphql
# Gap recovery is opt-in. When enabled, a mature GraphQL zero-overlap signal
# may read /nuevos?page=N sequentially until a persisted threadId is found.
GRAPHQL_GAP_RECOVERY_ENABLED=false
GRAPHQL_GAP_RECOVERY_MAX_PAGES=5
LLM_ENABLED=true
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
# Zona horaria por defecto de los horarios de aviso por alerta. Cada alerta
# puede fijar la suya («Avísame de portátiles solo entre las 08:00 y las 23:00
# Europe/Madrid»); esta es la que se aplica cuando el mensaje no la nombra.
# OJO: el horario solo decide CUÁNDO se envía Telegram. Un chollo que aparece
# fuera del horario no se pierde: queda pendiente y se envía al abrirse la
# ventana.
ALERT_TIMEZONE=Europe/Madrid
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Multiusuario: con false se conserva el modo single-user actual.
TELEGRAM_MULTIUSER_ENABLED=false
# No registrar usuarios desconocidos automáticamente salvo que se decida explícitamente.
TELEGRAM_AUTO_REGISTER=false
# El bot multiusuario opera exclusivamente en chats privados de Telegram.
# Opcional: identidad Telegram del usuario legacy, si se conoce con seguridad.
# TELEGRAM_USER_ID=
# SQLite persistente. En Compose se monta ./data en /app/data.
DATABASE_PATH=/app/data/chollometro.sqlite3
# Limpieza automática de históricos no críticos. Los valores 0 desactivan el
# pruning de esa categoría; feed_threads/deals/matches/pendientes nunca se
# eliminan automáticamente porque forman parte de la deduplicación/reintento.
RETENTION_ENABLED=true
RETENTION_FEED_THREADS_DAYS=0
RETENTION_SNAPSHOTS_HOURS=24
RETENTION_OBSERVATIONS_DAYS=0
RETENTION_LLM_CACHE_DAYS=30
RETENTION_ERROR_HISTORY_DAYS=90
RETENTION_SCAN_HISTORY_DAYS=90
RETENTION_BATCH_SIZE=500
RETENTION_INTERVAL_HOURS=24
# Temperature momentum is opt-in. Snapshots are collected for recent deals;
# Telegram momentum matching only activates when this flag is true.
TEMPERATURE_MOMENTUM_ENABLED=false
TEMPERATURE_MOMENTUM_MAX_AGE_HOURS=3
TEMPERATURE_MOMENTUM_WINDOW_MINUTES=15
TEMPERATURE_MOMENTUM_MIN_VELOCITY=3.0
TEMPERATURE_MOMENTUM_RESET_VELOCITY=2.0
TEMPERATURE_MOMENTUM_RETENTION_HOURS=24
