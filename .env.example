MILK_MAX_PRICE=
# Umbral exclusivo: solo se alertan ofertas de leche por debajo de este valor (€/L).
MILK_MAX_PRICE_PER_LITER=0.80
MILK_MIN_TEMPERATURE=
MILK_INCLUDE_KEYWORDS=
MILK_EXCLUDE_KEYWORDS=
MILK_INCLUDE_MERCHANTS=
MILK_EXCLUDE_MERCHANTS=
BEER_MAX_PRICE=
BEER_MIN_TEMPERATURE=
BEER_INCLUDE_KEYWORDS=
BEER_EXCLUDE_KEYWORDS=
BEER_INCLUDE_MERCHANTS=
BEER_EXCLUDE_MERCHANTS=
ERROR_ALERT_COOLDOWN_MINUTES=60
# Cadencia del daemon (`chollometro-alerts run`). `--interval-minutes` la
# sobreescribe. El primer ciclo inicializa el feed, y los deals publicados
# después de crear una alerta siguen siendo elegibles para esa alerta.
SCAN_INTERVAL_MINUTES=10
# Política HTTP de Chollometro: un timeout explícito y retries acotados con
# backoff exponencial (los 4xx y los fallos de parsing no se reintentan).
CHOLLOMETRO_TIMEOUT_SECONDS=20
CHOLLOMETRO_MAX_RETRIES=2
CHOLLOMETRO_RETRY_BACKOFF_SECONDS=0.5
CHOLLOMETRO_MAX_RETRY_BACKOFF_SECONDS=30
# Descubrimiento por la API GraphQL interna (feed de los últimos threads).
# true: el ciclo pide los últimos chollos una sola vez y evalúa solo los nuevos.
# false: se mantiene el escaneo HTML por consulta, sin tocar el endpoint GraphQL.
CHOLLOMETRO_GRAPHQL_DISCOVERY=true
# Ventana de visibilidad del feed. Sin definir (recomendado) la petición NO
# envía `limit` y el endpoint devuelve su ventana por defecto: 30 threads.
# Un valor entre 1 y 20 pide esa ventana explícita. Un valor >= 21 se rechaza:
# el endpoint lo recorta a 20 sin avisar.
# CHOLLOMETRO_GRAPHQL_WINDOW_LIMIT=20
CHOLLOMETRO_GRAPHQL_PATH=/graphql
LLM_ENABLED=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
