MILK_MAX_PRICE=
# Exclusive threshold: only milk deals below this value (€/L) trigger an alert.
MILK_MAX_PRICE_PER_LITER=0.80
MILK_MIN_TEMPERATURE=
MILK_INCLUDE_KEYWORDS=
MILK_EXCLUDE_KEYWORDS=
# Merchants for legacy rules (check/baseline/run-rules --dry-run). Alerts
# created from Telegram carry their own allowed and excluded merchants inside
# the rule ("from Amazon or PcComponentes but not AliExpress").
MILK_INCLUDE_MERCHANTS=
MILK_EXCLUDE_MERCHANTS=
BEER_MAX_PRICE=
BEER_MIN_TEMPERATURE=
BEER_INCLUDE_KEYWORDS=
BEER_EXCLUDE_KEYWORDS=
BEER_INCLUDE_MERCHANTS=
BEER_EXCLUDE_MERCHANTS=
# Minutes between two operational alerts of the same type (Chollometro errors,
# Telegram failures, etc.). Values below 1 are rejected: the cooldown exists
# specifically to prevent a 503 from turning into alert spam.
ERROR_ALERT_COOLDOWN_MINUTES=60
# Pepper site used by the scanner. Validated values are chollometro, dealabs,
# mydealz, hotukdeals, pepper_pl, preisjaeger, promodescuentos, pepper_nl and
# pepperdeals_se. Chollometro preserves the legacy default.
PEPPER_SITE=chollometro
# Daemon cadence (`chollo-alerts run`). `--interval-minutes` overrides it.
# The first cycle initializes the feed, and deals published after an alert was
# created remain eligible for that alert.
SCAN_INTERVAL_MINUTES=10
# Optional adaptive GraphQL polling. Disabled preserves the legacy cadence.
ADAPTIVE_POLLING_ENABLED=false
ADAPTIVE_POLLING_INTERVAL_SECONDS=120
ADAPTIVE_POLLING_TRIGGER_RATIO=0.70
ADAPTIVE_POLLING_RESET_RATIO=0.30
ADAPTIVE_POLLING_COOLDOWN_CYCLES=3
# Health is stale after max(SCAN_INTERVAL_MINUTES * 3, 15 minutes).
# Override only when the scan cadence or expected latency requires it.
HEALTH_STALE_AFTER_MINUTES=30
HEALTH_STARTUP_GRACE_MINUTES=20
# Chollometro HTTP policy: explicit timeout and bounded retries with
# exponential backoff (4xx responses and parsing failures are not retried).
CHOLLOMETRO_TIMEOUT_SECONDS=20
CHOLLOMETRO_MAX_RETRIES=2
CHOLLOMETRO_RETRY_BACKOFF_SECONDS=0.5
CHOLLOMETRO_MAX_RETRY_BACKOFF_SECONDS=30
# Discovery through the internal GraphQL API (feed of the latest threads).
# true: each cycle fetches the latest deals once and evaluates only new ones.
# false: keeps per-query HTML scanning and does not touch the GraphQL endpoint.
CHOLLOMETRO_GRAPHQL_DISCOVERY=true
# Feed visibility window. When unset (recommended), the request does NOT send
# `limit`, and the endpoint returns its default window: 30 threads.
# A value from 1 to 20 requests that window explicitly. Values >= 21 are
# rejected because the endpoint silently clamps them to 20.
# CHOLLOMETRO_GRAPHQL_WINDOW_LIMIT=20
CHOLLOMETRO_GRAPHQL_PATH=/graphql
# Gap recovery is opt-in. When enabled, a mature GraphQL zero-overlap signal
# may read /nuevos?page=N sequentially until a persisted threadId is found.
GRAPHQL_GAP_RECOVERY_ENABLED=false
GRAPHQL_GAP_RECOVERY_MAX_PAGES=5
# Optional LLM extraction fallback. Keep false for a deterministic setup.
LLM_ENABLED=false
# Recommended: ordered providers. Providers without an API key are skipped.
# LLM_PROVIDERS=deepseek,openai,gemini
# Legacy single-provider setting, used only when LLM_PROVIDERS is not set.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=2
# Telegram alert interpretation (default: hybrid):
# deterministic = deterministic interpretation without prioritizing the LLM.
# hybrid = existing hybrid behavior.
# llm_first = tries the LLM backend first and uses deterministic fallback if
# the LLM fails or its output does not validate.
TELEGRAM_ALERT_NLP_MODE=hybrid
# Default timezone for per-alert notification schedules. Each alert can set
# its own ("Notify me about laptops only between 08:00 and 23:00
# Europe/Madrid"); this value is used when the message does not name one.
# NOTE: the schedule only decides WHEN Telegram is sent. A deal that appears
# outside the schedule is not lost: it remains pending and is sent when the
# window opens.
ALERT_TIMEZONE=Europe/Madrid
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Multi-user mode: false preserves the current single-user behavior.
TELEGRAM_MULTIUSER_ENABLED=false
# Do not register unknown users automatically unless explicitly enabled.
TELEGRAM_AUTO_REGISTER=false
# The multi-user bot operates exclusively in private Telegram chats.
# Optional: Telegram identity of the legacy user, when known with confidence.
# TELEGRAM_USER_ID=
# Persistent SQLite database. Local execution uses a relative path; Compose
# overrides it with /app/data/chollometro.sqlite3 inside the shared Docker volume.
DATABASE_PATH=chollometro.sqlite3
# Scanner metrics port scraped by Prometheus.
METRICS_PORT=8000
# Prometheus UI/API is exposed on host port 9090 by compose.yaml (fixed).
# Observability endpoints and local Grafana login. Change the password before
# exposing Grafana outside a trusted local network.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
ALERTMANAGER_PORT=9093
# Automatic cleanup of non-critical historical data. A value of 0 disables
# pruning for that category; feed_threads/deals/matches/pending records are
# never deleted automatically because they are part of deduplication/retry state.
RETENTION_ENABLED=true
DEAL_RETENTION_DAYS=15
RETENTION_FEED_THREADS_DAYS=0
RETENTION_SNAPSHOTS_HOURS=24
RETENTION_OBSERVATIONS_DAYS=0
RETENTION_LLM_CACHE_DAYS=30
RETENTION_ERROR_HISTORY_DAYS=90
RETENTION_SCAN_HISTORY_DAYS=90
RETENTION_BATCH_SIZE=500
RETENTION_INTERVAL_HOURS=24
# Temperature momentum is opt-in. Snapshots are collected for recent deals;
# Telegram momentum matching only activates when this flag is true.
TEMPERATURE_MOMENTUM_ENABLED=false
TEMPERATURE_MOMENTUM_MAX_AGE_HOURS=3
TEMPERATURE_MOMENTUM_WINDOW_MINUTES=15
TEMPERATURE_MOMENTUM_MIN_VELOCITY=3.0
TEMPERATURE_MOMENTUM_RESET_VELOCITY=2.0
TEMPERATURE_MOMENTUM_RETENTION_HOURS=24
